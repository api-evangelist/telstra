{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telstra Messaging Authentication HealthCheck API",
    "version": "2.2.10"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://tapi.telstra.com/v2/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "HealthCheck",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Telstra SMS Healthcheck",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tapi.telstra.com/v2/messages/sms/healthcheck"
          },
          "docs": "Service availability indicator for SMS messaging."
        },
        {
          "info": {
            "name": "Telstra MMS Healthcheck",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tapi.telstra.com/v2/messages/mms/healthcheck"
          },
          "docs": "Service availability indicator for MMS messaging."
        }
      ]
    }
  ],
  "bundled": true
}