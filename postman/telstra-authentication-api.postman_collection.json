                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) The application's client ID issued by dev.telstra.com.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The application's client secret.",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) ",
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "key": "scope",
                      "value": "NSMS"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/oauth/token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "oauth",
                    "token"
                  ]
                },
                "description": "Generate an OAuth 2.0 bearer token using the client credentials grant with the NSMS scope."
